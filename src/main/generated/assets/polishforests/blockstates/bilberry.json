{
  "multipart": [
    {
      "apply": {
        "model": "polishforests:block/bilberry"
      }
    },
    {
      "apply": {
        "model": "polishforests:block/bilberry_berries"
      },
      "when": {
        "berries": "true"
      }
    },
    {
      "apply": [
        {
          "model": "polishforests:block/forest_moss_layer"
        },
        {
          "model": "polishforests:block/forest_moss_layer",
          "y": 90
        },
        {
          "model": "polishforests:block/forest_moss_layer",
          "y": 180
        },
        {
          "model": "polishforests:block/forest_moss_layer",
          "y": 270
        }
      ],
      "when": {
        "mossy": "true"
      }
    }
  ]
}